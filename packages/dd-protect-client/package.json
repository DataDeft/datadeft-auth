{
  "name": "@datadeft/protect-client",
  "version": "0.4.0",
  "description": "Browser proof-of-work client and Web Worker for datadeft-pow-core.",
  "type": "module",
  "main": "./dist/protect.js",
  "types": "./dist/protect.d.ts",
  "exports": {
    ".": {
      "types": "./dist/protect.d.ts",
      "import": "./dist/protect.js",
      "default": "./dist/protect.js"
    },
    "./worker": {
      "types": "./dist/protect-worker.d.ts",
      "import": "./dist/protect-worker.js",
      "default": "./dist/protect-worker.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/protect-worker.js"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DataDeft/datadeft-auth.git",
    "directory": "packages/dd-protect-client"
  },
  "homepage": "https://github.com/DataDeft/datadeft-auth/tree/main/packages/dd-protect-client",
  "keywords": [
    "proof-of-work",
    "authentication",
    "web-worker",
    "browser"
  ],
  "scripts": {
    "lint": "eslint ts/ scripts/",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.scripts.json",
    "test": "bun test ts/",
    "build": "bun scripts/build.ts",
    "test:package": "bun scripts/check-package.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "^1.3.14",
    "eslint": "^9.39.2",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^16.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.51.0"
  },
  "license": "MIT",
  "author": "Istvan <dev@l1x.be>"
}
