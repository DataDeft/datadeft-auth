{
  "name": "datadeft-auth-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "fmt": "prettier --write \"**/*.{ts,js,mjs}\"",
    "fmt:check": "prettier --check \"**/*.{ts,js,mjs}\"",
    "typecheck": "tsc -p tsconfig.scripts.json",
    "lint": "eslint scripts/"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "^1.3.14",
    "eslint": "^9.39.2",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^16.5.0",
    "prettier": "3.10.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.51.0"
  }
}
